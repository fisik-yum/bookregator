package pages

import (
	"net/http"
	"server/web/shared"
)

type Index struct {
	shared.Base
}

func NewIndex() *Index {
	return &Index{shared.NewBase("Bookregator")}
}
func (i *Index) Render(w http.ResponseWriter, r *http.Request) {
	i.Html().Render(r.Context(), w)
}

templ (i *Index) Html() {
	@i.Base.Html() {
		<div class="page-content">
			<h1>bookregator</h1>
			<p>the book review aggregator</p>
			<form method="get" action="search">
				<input name="query" id="query" type="search" placeholder="Search Me!"/>
			</form>
		</div>
	}
}
