package pages

import (
	"net/http"
	"server/db"
	"server/web/components"
	"server/web/shared"
)

type Work struct {
	shared.Base
	reviews  []db.Review
	work     db.Work
    stats db.Stat
	recWorks []db.Work
}

func NewReview(reviews []db.Review, work db.Work, stat db.Stat, recWorks []db.Work) *Work {
	return &Work{shared.NewBase(work.Title), reviews, work, stat, recWorks}
}
func (v *Work) Render(w http.ResponseWriter, r *http.Request) {
	v.Html().Render(r.Context(), w)
}

templ (v *Work) Html() {
	@v.Base.Html() {
		@components.BookInfoBox(v.work,v.stats)
		if len(v.recWorks) > 0 {
			<h3>Similar Books</h3>
			@components.RecommendationStrip(v.recWorks)
		}
		for _,val:=range v.reviews {
			@components.ReviewCard(val)
		}
	}
}
