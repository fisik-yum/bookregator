package components

import (
	"fmt"
	"server/db"
	"strconv"
)

templ SearchItem(w db.Work, s db.Stat) {
	<div class="search-result">
		<div class="search-result-header">
			<a href={ "book?olid=" + w.Olid }>{ w.Title }</a>
			<span class="badge">
				if s.AvgRating<=0 {
					No Rating
				} else {
					{ strconv.FormatFloat(s.AvgRating,'f',2,64) }
				}
				| { s.ReviewCount } ratings
			</span>
		</div>
		<div class="search-result-body">
			if w.Cover!=nil {
				<img src={ fmt.Sprintf("https://covers.openlibrary.org/b/id/%s-M.jpg", *w.Cover) } class="book-cover" alt="book cover"/>
			} else {
				<img src={ "https://openlibrary.org/images/icons/avatar_book-lg.png" } class="book-cover" alt="book cover"/>
			}
			if w.Description!=nil {
				<p>{ *w.Description }</p>
			}
		</div>
	</div>
}
